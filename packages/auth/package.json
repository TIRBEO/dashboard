{
  "name": "@tirbeo/auth",
  "version": "1.0.0",
  "description": "Tirbeo shared authentication package",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jwt": {
      "types": "./dist/jwt.d.ts",
      "import": "./dist/jwt.mjs",
      "require": "./dist/jwt.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@tirbeo/api-client": "workspace:*",
    "@tirbeo/database": "workspace:*",
    "jose": "6.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsup": "^8.3.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}

